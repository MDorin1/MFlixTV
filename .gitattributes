# 统一换行符，避免 Windows/macOS 混提交产生整文件 diff
* text=auto eol=lf

# Windows 专用脚本必须是 CRLF，否则 cmd/bat 解析异常
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.iss       text eol=crlf

# macOS / Unix 脚本与全部源码保持 LF
*.command   text eol=lf
*.sh        text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf

# 二进制：不要做任何换行/文本转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.zip       binary
*.exe       binary
*.dmg       binary
*.woff      binary
*.woff2     binary
package-lock.json  -diff linguist-generated
