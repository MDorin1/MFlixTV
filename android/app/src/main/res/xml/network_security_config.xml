<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 局域网 http 必须放行：手机自己就是服务端，别的设备访问手机 IP:8080 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
