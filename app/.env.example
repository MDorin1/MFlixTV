# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# MFLIXTV_IMAGE=ghcr.io/librespark/libretv:<版本>

# ---------------------------------------------------------------------------
# 桌面版（本仓库新增）
# ---------------------------------------------------------------------------
# 点播源：JSON 数组，name + url（苹果CMS v10 的 /api.php/provide/vod）。
# 不填就走上游默认值。桌面版由 tools\update.ps1 -Part sources 自动探测并写回本项，
# 也可以自己加几条：
# DEFAULT_SOURCES=[{"name":"示例源A","url":"https://example-a.com/api.php/provide/vod"},{"name":"示例源B","url":"https://example-b.com/api.php/provide/vod"}]

# 直播源：M3U / M3U8 订阅地址
# DEFAULT_LIVE_SOURCES=[{"name":"示例IPTV","url":"https://example.com/iptv.m3u"}]

# 首页推荐来源：douban（豆瓣榜单）/ 60s
# DEFAULT_RECOMMEND_SOURCE=douban

# 搜索参数：单源超时与翻页数，桌面版默认放宽到 10s / 2 页
# SEARCH_MAX_PAGES=2
# SEARCH_SOURCE_TIMEOUT_MS=10000
